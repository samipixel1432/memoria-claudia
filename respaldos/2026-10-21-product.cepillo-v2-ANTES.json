    "faq": {
      "type": "tovelya-cepillo-v2-faq",
      "blocks": {
        "faq_1": {
          "type": "pregunta",
          "settings": {
            "pregunta": "¿Cómo funciona el pago contra entrega?",
            "respuesta": "<p>Haces el pedido sin pagar nada. Te contactamos para confirmar datos y cobertura, despachamos y pagas en efectivo al recibir.</p>"
          }
        },
        "faq_2": {
          "type": "pregunta",
          "settings": {
            "pregunta": "¿Cómo sé que no es una estafa?",
            "respuesta": "<p>No pagas nada por adelantado. Antes de enviarlo te escribimos por WhatsApp para confirmar tu pedido, y pagas $129.900 en efectivo cuando el transportador te lo entrega.</p>"
          }
        },
        "faq_3": {
          "type": "pregunta",
          "settings": {
            "pregunta": "¿Cuánto tarda en llegar?",
            "respuesta": "<p>El tiempo depende de tu ciudad y de la cobertura de la transportadora. Te lo confirmamos por WhatsApp antes del despacho.</p>"
          }
        },
        "faq_4": {
          "type": "pregunta",
          "settings": {
            "pregunta": "¿Qué pasa si llega con una falla?",
            "respuesta": "<p>Las fallas de fábrica se atienden según la política de devoluciones de Tovelya. Escríbenos por WhatsApp con fotos o video del producto.</p>"
          }
        },
        "faq_5": {
          "type": "pregunta",
          "settings": {
            "pregunta": "¿Sirve para superficies delicadas?",
            "respuesta": "<p>Sí: incluye cabezales suaves y de esponja. Usa los de cerdas duras solo en baldosa, ollas o rines, y prueba primero en una zona poco visible.</p>"
          }
        },
        "faq_6": {
          "type": "pregunta",
          "settings": {
            "pregunta": "¿Cómo se carga y cuánto dura la batería?",
            "respuesta": "<p>Se carga con el cable incluido. La autonomía depende de la intensidad y del tiempo de uso.</p>"
          }
        },
        "faq_7": {
          "type": "pregunta",
          "settings": {
            "pregunta": "¿Se puede mojar?",
            "respuesta": "<p>Puede usarse en limpieza húmeda, pero no sumerjas el cuerpo del motor ni el puerto de carga.</p>"
          }
        }
      },
