{% liquid
  assign cat_ids = 'hogar|movimiento|bienestar' | split: '|'
  assign cat_kickers = 'Para tu espacio|Tecnología útil|Para sentirte mejor' | split: '|'
  assign cat_titles = 'Hogar y cocina|Entretenimiento y movimiento|Bienestar y cuidado personal' | split: '|'
  assign cat_texts = 'Soluciones para limpiar, organizar y simplificar las tareas de todos los días.|Equipos para disfrutar en casa, viajar mejor y estar preparado en el camino.|Opciones pensadas para acompañar tu postura, entrenamiento y comodidad diaria.' | split: '|'
  assign cat_handles = 'cepillo-electrico-recargable-7-en-1,hidrolavadora-inalambrica-48v,bomba-vacio-alimentos,trapero-electrico-inalambrico|mini-proyector-led,traje-impermeable-lluvia,pantalla-carplay-para-moto,inflador-arrancador-portatil-4-en-1|chaleco-soporte-postural,soporte-termico-hombro,faja-waist-trainer,camisilla-termica-hombre' | split: '|'
  assign cat_links = '/collections/hogar|/collections/tecnologia|/collections/bienestar' | split: '|'
  assign wa = 'https://wa.me/573232552543?text=Hola%20Tovelya%2C%20quiero%20conocer%20sus%20productos.'
%}

<div class="tvh" data-tovelya-brand-home>
  <svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false"><defs>
    <symbol id="tvh-check" viewBox="0 0 24 24"><path d="M5 12.5l4.2 4.2L19 7"/></symbol>
    <symbol id="tvh-camion" viewBox="0 0 24 24"><path d="M2.5 6.5h12v10h-12zM14.5 10h4l2.5 3v3.5h-6.5"/><circle cx="7" cy="17.5" r="1.8"/><circle cx="17.5" cy="17.5" r="1.8"/></symbol>
    <symbol id="tvh-billete" viewBox="0 0 24 24"><rect x="2.5" y="6" width="19" height="12" rx="2"/><circle cx="12" cy="12" r="2.6"/><path d="M6 9.5v5M18 9.5v5"/></symbol>
    <symbol id="tvh-chat" viewBox="0 0 24 24"><path d="M4 5.5h16v10H9l-5 4z"/><path d="M8 10.5h8"/></symbol>
    <symbol id="tvh-escudo" viewBox="0 0 24 24"><path d="M12 3l7 3v5c0 4.6-3 8.1-7 10-4-1.9-7-5.4-7-10V6z"/><path d="M9 12l2 2 4-4.5"/></symbol>
    <symbol id="tvh-flecha" viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"/></symbol>
    <symbol id="tvh-abajo" viewBox="0 0 24 24"><path d="M12 5v14M6 13l6 6 6-6"/></symbol>
    <symbol id="tvh-izq" viewBox="0 0 24 24"><path d="M15 5l-7 7 7 7"/></symbol>
    <symbol id="tvh-der" viewBox="0 0 24 24"><path d="M9 5l7 7-7 7"/></symbol>
    <symbol id="tvh-estrella" viewBox="0 0 24 24"><path d="M12 3.5l2.6 5.4 5.9.8-4.3 4.1 1 5.8L12 16.8 6.8 19.6l1-5.8L3.5 9.7l5.9-.8z"/></symbol>
    <symbol id="tvh-wa" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.198-.347.223-.644.075-.297-.149-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479s1.065 2.875 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.262.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.29.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.981.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.894 6.99c-.003 5.45-4.437 9.884-9.888 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/></symbol>
  </defs></svg>

  <div class="tvh-topbar"><div class="tvh-wrap">{{ section.settings.announcement }}</div></div>

  <header class="tvh-header" data-tvh-header>
    <div class="tvh-wrap tvh-header-in">
      <a class="tvh-logo" href="{{ routes.root_url }}" aria-label="Tovelya, inicio">
        {%- if settings.logo != blank -%}
          {{ settings.logo | image_url: width: 400 | image_tag: loading: 'eager', alt: 'Tovelya', widths: '200, 400', sizes: '140px' }}
        {%- else -%}
          <img src="https://cdn.shopify.com/s/files/1/0955/3523/5319/t/1/assets/tovelya-logo-horizontal.png?v=1789520576" alt="Tovelya" width="1844" height="534">
        {%- endif -%}
      </a>
      <nav class="tvh-nav" aria-label="Navegación principal">
        <a class="tvh-nav-link" href="#descubrir">Productos</a>
        <a class="tvh-nav-link" href="#como-compras">Cómo compras</a>
        <a class="tvh-nav-link" href="#opiniones">Opiniones</a>
        <a class="tvh-wa-btn" href="{{ wa }}" target="_blank" rel="noopener" aria-label="Hablar con Tovelya por WhatsApp"><svg aria-hidden="true"><use href="#tvh-wa"/></svg></a>
        <a class="tvh-btn tvh-btn-sm" href="#descubrir">Ver productos</a>
      </nav>
    </div>
  </header>

  <div class="tvh-main">
    <section class="tvh-hero" aria-labelledby="tvh-hero-title">
      <div class="tvh-wrap tvh-hero-in">
        <div class="tvh-hero-copy">
          <p class="tvh-eyebrow">Tovelya · Colombia</p>
          <h1 id="tvh-hero-title">Lo útil también puede sentirse <em>especial</em></h1>
          <p class="tvh-lead">Productos pensados para hacer más fácil la rutina, el hogar y tus planes.</p>
          <div class="tvh-hero-ctas">
            <a class="tvh-btn" href="#descubrir">Ver productos <svg aria-hidden="true"><use href="#tvh-abajo"/></svg></a>
            <a class="tvh-btn tvh-btn-ghost-light" href="#como-compras">Cómo compras</a>
          </div>
          <ul class="tvh-risk" aria-label="Así compras en Tovelya">
            <li><svg aria-hidden="true"><use href="#tvh-check"/></svg>Pagas al recibir</li>
            <li><svg aria-hidden="true"><use href="#tvh-check"/></svg>Envío en Colombia</li>
            <li><svg aria-hidden="true"><use href="#tvh-check"/></svg>Confirmación por WhatsApp</li>
          </ul>
        </div>
        <figure class="tvh-hero-media">
          <img src="{{ 'tovelya-hero-banner-tres-productos.jpg' | asset_url }}" srcset="{{ 'tovelya-hero-banner-tres-productos.jpg' | asset_url }}&width=960 960w, {{ 'tovelya-hero-banner-tres-productos.jpg' | asset_url }}&width=1400 1400w, {{ 'tovelya-hero-banner-tres-productos.jpg' | asset_url }} 2000w" sizes="(max-width: 749px) 195vw, 100vw" alt="Selección de productos Tovelya para el hogar, entretenimiento y recorridos." width="2000" height="768" loading="eager" fetchpriority="high">
        </figure>
      </div>
    </section>

    <section class="tvh-trust" aria-label="Por qué comprar tranquilo">
      <div class="tvh-wrap tvh-trust-grid">
        <div class="tvh-trust-item"><span class="tvh-badge-trust"><svg aria-hidden="true"><use href="#tvh-billete"/></svg></span><span><b>Pago al recibir</b>Pagas cuando llega tu pedido</span></div>
        <div class="tvh-trust-item"><span class="tvh-badge-trust"><svg aria-hidden="true"><use href="#tvh-camion"/></svg></span><span><b>Envío en Colombia</b>Sujeto a cobertura de tu ciudad</span></div>
        <div class="tvh-trust-item"><span class="tvh-badge-trust"><svg aria-hidden="true"><use href="#tvh-chat"/></svg></span><span><b>Confirmación personal</b>Hablamos contigo antes de enviar</span></div>
        <div class="tvh-trust-item"><span class="tvh-badge-trust"><svg aria-hidden="true"><use href="#tvh-escudo"/></svg></span><span><b>Compra respaldada</b>Según nuestras políticas publicadas</span></div>
      </div>
    </section>

    <section class="tvh-manifesto">
      <div class="tvh-wrap tvh-head tvh-head-center" data-rv>
        <p class="tvh-eyebrow">Nuestra forma de elegir</p>
        <h2>Menos complicaciones. <em>Más momentos que sí importan.</em></h2>
        <p class="tvh-lead">Reunimos soluciones prácticas para acompañar tu día sin llenarlo de cosas innecesarias.</p>
      </div>
    </section>

    <section class="tvh-catalog" id="descubrir" aria-labelledby="tvh-catalog-title">
      <div class="tvh-wrap tvh-head tvh-head-center">
        <p class="tvh-eyebrow">Catálogo Tovelya</p>
        <h2 id="tvh-catalog-title">Encuentra lo que <em>necesitas</em></h2>
        <p class="tvh-lead">Elige un producto y entra a su página para conocerlo completo.</p>
        <nav class="tvh-chips" aria-label="Categorías">
          {%- for id in cat_ids -%}<a href="#cat-{{ id }}">{{ cat_titles[forloop.index0] }}</a>{%- endfor -%}
        </nav>
      </div>

      {%- for id in cat_ids -%}
        {%- assign i = forloop.index0 -%}
        {%- assign handles = cat_handles[i] | split: ',' -%}
        <section class="tvh-cat{% if i == 1 %} tvh-cat-dark{% endif %}{% if i == 2 %} tvh-cat-paper{% endif %}" id="cat-{{ id }}" aria-labelledby="tvh-cat-title-{{ id }}">
          <div class="tvh-wrap">
            <div class="tvh-cat-head">
              <div><p class="tvh-eyebrow">{{ cat_kickers[i] }}</p><h3 id="tvh-cat-title-{{ id }}">{{ cat_titles[i] }}</h3></div>
              <p>{{ cat_texts[i] }}<a class="tvh-cat-all" href="{{ cat_links[i] }}">Ver toda la categoría <svg aria-hidden="true"><use href="#tvh-flecha"/></svg></a></p>
            </div>
            <div class="tvh-cards">
              {%- for h in handles -%}
                {%- assign p = all_products[h] -%}
                {%- if p == empty or p == nil or p.title == blank -%}{%- continue -%}{%- endif -%}
                <article class="tvh-card" data-rv style="--i:{{ forloop.index0 }}">
                  <a class="tvh-card-media" href="{{ p.url }}" tabindex="-1" aria-hidden="true">
                    {%- if p.featured_image != blank -%}
                      {{ p.featured_image | image_url: width: 720 | image_tag: widths: '320, 480, 640, 720', sizes: '(min-width: 990px) 280px, (min-width: 750px) 45vw, 74vw', loading: 'lazy', alt: p.title }}
                    {%- else -%}
                      {{ 'product-1' | placeholder_svg_tag: 'tvh-placeholder' }}
                    {%- endif -%}
                    {%- if p.compare_at_price > p.price -%}<span class="tvh-save">-{{ p.compare_at_price | minus: p.price | times: 100 | divided_by: p.compare_at_price }}%</span>{%- endif -%}
                  </a>
                  <div class="tvh-card-body">
                    {%- if p.type != blank -%}<p class="tvh-card-type">{{ p.type }}</p>{%- endif -%}
                    <h4><a href="{{ p.url }}">{{ p.title }}</a></h4>
                    <div class="tvh-price"><strong>{% if p.price_varies %}Desde {% endif %}{{ p.price | money_without_trailing_zeros }}</strong>{%- if p.compare_at_price > p.price -%}<s>{{ p.compare_at_price | money_without_trailing_zeros }}</s>{%- endif -%}</div>
                    <a class="tvh-card-link" href="{{ p.url }}">Ver producto <svg aria-hidden="true"><use href="#tvh-flecha"/></svg></a>
                  </div>
                </article>
              {%- endfor -%}
            </div>
          </div>
        </section>
      {%- endfor -%}
    </section>

    <section class="tvh-steps" id="como-compras" aria-labelledby="tvh-steps-title">
      <div class="tvh-wrap">
        <div class="tvh-head tvh-head-center">
          <p class="tvh-eyebrow">Cómo compras</p>
          <h2 id="tvh-steps-title">Pides hoy. <em>Pagas cuando llegue.</em></h2>
        </div>
        <ol class="tvh-steps-grid">
          <li class="tvh-step" data-rv style="--i:0"><span class="tvh-step-n" aria-hidden="true">1</span><h3>Elige tu producto</h3><p>Entra a su página y haz el pedido en menos de un minuto.</p></li>
          <li class="tvh-step" data-rv style="--i:1"><span class="tvh-step-n" aria-hidden="true">2</span><h3>Te confirmamos</h3><p>Revisamos contigo por WhatsApp tus datos, dirección y cobertura.</p></li>
          <li class="tvh-step" data-rv style="--i:2"><span class="tvh-step-n" aria-hidden="true">3</span><h3>Despachamos</h3><p>Enviamos tu pedido a tu ciudad en Colombia.</p></li>
          <li class="tvh-step" data-rv style="--i:3"><span class="tvh-step-n" aria-hidden="true">4</span><h3>Recibes y pagas</h3><p>Pagas al transportador cuando lo tienes en la mano.</p></li>
        </ol>
        <div class="tvh-cta-mid"><a class="tvh-btn" href="#descubrir">Ver productos <svg aria-hidden="true"><use href="#tvh-flecha"/></svg></a></div>
      </div>
    </section>

    <section class="tvh-inspiration" aria-labelledby="tvh-insp-title">
      <div class="tvh-wrap">
        <div class="tvh-track-head">
          <div class="tvh-head"><p class="tvh-eyebrow">Tovelya en la vida real</p><h2 id="tvh-insp-title">Pequeñas soluciones. <em>Grandes diferencias.</em></h2></div>
          <div class="tvh-track-nav"><button type="button" data-dir="-1" aria-label="Imagen anterior"><svg aria-hidden="true"><use href="#tvh-izq"/></svg></button><button type="button" data-dir="1" aria-label="Imagen siguiente"><svg aria-hidden="true"><use href="#tvh-der"/></svg></button></div>
        </div>
        <div class="tvh-track" data-tvh-track tabindex="0" role="region" aria-label="Productos Tovelya en uso">
          <figure><img src="{{ 'tovelya-cepillo-cambio-cabezal-v1.png' | asset_url }}&width=800&format=pjpg" srcset="{{ 'tovelya-cepillo-cambio-cabezal-v1.png' | asset_url }}&width=480&format=pjpg 480w, {{ 'tovelya-cepillo-cambio-cabezal-v1.png' | asset_url }}&width=800&format=pjpg 800w, {{ 'tovelya-cepillo-cambio-cabezal-v1.png' | asset_url }}&width=1100&format=pjpg 1100w" sizes="(min-width: 990px) 34vw, 80vw" alt="Cambio de cabezal del cepillo eléctrico Tovelya." width="1536" height="1024" loading="lazy"><figcaption>Adáptalo a cada tarea</figcaption></figure>
          <figure><img src="{{ 'tovelya-mini-proyector-03-cine-en-casa.webp' | asset_url }}&width=800" srcset="{{ 'tovelya-mini-proyector-03-cine-en-casa.webp' | asset_url }}&width=480 480w, {{ 'tovelya-mini-proyector-03-cine-en-casa.webp' | asset_url }}&width=800 800w, {{ 'tovelya-mini-proyector-03-cine-en-casa.webp' | asset_url }}&width=1100 1100w" sizes="(min-width: 990px) 34vw, 80vw" alt="Noche de cine familiar con mini proyector." width="1122" height="1402" loading="lazy"><figcaption>Comparte algo diferente</figcaption></figure>
          <figure><img src="{{ 'tovelya-inflador-arrancador-04-inflado-digital.jpg' | asset_url }}&width=800" srcset="{{ 'tovelya-inflador-arrancador-04-inflado-digital.jpg' | asset_url }}&width=480 480w, {{ 'tovelya-inflador-arrancador-04-inflado-digital.jpg' | asset_url }}&width=800 800w, {{ 'tovelya-inflador-arrancador-04-inflado-digital.jpg' | asset_url }}&width=1100 1100w" sizes="(min-width: 990px) 34vw, 80vw" alt="Inflador portátil junto a la rueda de un vehículo." width="1122" height="1402" loading="lazy"><figcaption>Prepárate para el camino</figcaption></figure>
        </div>
      </div>
    </section>

    <section class="tvh-social" id="opiniones" aria-labelledby="tvh-social-title">
      <div class="tvh-wrap">
        <div class="tvh-head"><p class="tvh-eyebrow">Compras confirmadas</p><h2 id="tvh-social-title">Experiencias reales, <em>sin adornos</em></h2></div>
        <div class="tvh-quotes">
          <blockquote class="tvh-quote" data-rv style="--i:0"><span class="tvh-stars" role="img" aria-label="5 de 5 estrellas">{% for s in (1..5) %}<svg aria-hidden="true"><use href="#tvh-estrella"/></svg>{% endfor %}</span><p>“Me llegó rápido y en buen estado. Lo probé para limpiar el baño y hace la limpieza mucho más fácil.”</p><cite><svg aria-hidden="true"><use href="#tvh-check"/></svg>Compra confirmada en Tovelya</cite></blockquote>
          <blockquote class="tvh-quote" data-rv style="--i:1"><span class="tvh-stars" role="img" aria-label="5 de 5 estrellas">{% for s in (1..5) %}<svg aria-hidden="true"><use href="#tvh-estrella"/></svg>{% endfor %}</span><p>“Me llegó rápido y bien empacado. Ya lo probé para inflar una llanta y funcionó perfectamente.”</p><cite><svg aria-hidden="true"><use href="#tvh-check"/></svg>Compra confirmada en Tovelya</cite></blockquote>
        </div>
      </div>
    </section>

    <section class="tvh-faq" aria-labelledby="tvh-faq-title">
      <div class="tvh-wrap tvh-faq-grid">
        <div class="tvh-head"><p class="tvh-eyebrow">Preguntas frecuentes</p><h2 id="tvh-faq-title">Antes de <em>pedir</em></h2><p class="tvh-lead">¿Otra duda? Escríbenos por <a href="{{ wa }}" target="_blank" rel="noopener">WhatsApp</a>.</p></div>
        <div class="tvh-faq-list">
          <details><summary>¿Cómo funciona el pago al recibir?</summary><div class="tvh-faq-a"><p>Haces tu pedido y pagas al transportador cuando lo recibes. Antes de despachar te confirmamos los datos por WhatsApp.</p></div></details>
          <details><summary>¿Hacen envíos a toda Colombia?</summary><div class="tvh-faq-a"><p>Enviamos en Colombia, sujeto a la cobertura de la transportadora en tu ciudad. Te informamos el tiempo estimado cuando confirmamos tu pedido.</p></div></details>
          <details><summary>¿Qué pasa si mi producto llega con un problema?</summary><div class="tvh-faq-a"><p>Escríbenos por WhatsApp y lo revisamos contigo. Aplicamos nuestra <a href="/policies/refund-policy">política de devoluciones</a>.</p></div></details>
          <details><summary>¿Cómo me comunico con Tovelya?</summary><div class="tvh-faq-a"><p>Por <a href="{{ wa }}" target="_blank" rel="noopener">WhatsApp al +57 323 255 2543</a>. Te respondemos y te acompañamos antes del envío.</p></div></details>
        </div>
      </div>
    </section>

    <section class="tvh-closing" aria-labelledby="tvh-closing-title">
      <img src="{{ 'tovelya-hero-banner-tres-productos.jpg' | asset_url }}" srcset="{{ 'tovelya-hero-banner-tres-productos.jpg' | asset_url }}&width=960 960w, {{ 'tovelya-hero-banner-tres-productos.jpg' | asset_url }}&width=1400 1400w, {{ 'tovelya-hero-banner-tres-productos.jpg' | asset_url }} 2000w" sizes="100vw" alt="" width="2000" height="768" loading="lazy">
      <div class="tvh-wrap tvh-closing-in">
        <p class="tvh-eyebrow">Descubre tu próxima solución</p>
        <h2 id="tvh-closing-title">Hazle espacio a lo que <em>sí te ayuda</em></h2>
        <a class="tvh-btn" href="#descubrir">Explorar la selección <svg aria-hidden="true"><use href="#tvh-flecha"/></svg></a>
      </div>
    </section>
  </div>

  <footer class="tvh-footer">
    <div class="tvh-wrap">
      <div class="tvh-footer-top">
        <a class="tvh-footer-logo" href="{{ routes.root_url }}" aria-label="Tovelya, inicio">
          {%- if settings.logo_inverse != blank -%}
            {{ settings.logo_inverse | image_url: width: 400 | image_tag: loading: 'lazy', alt: 'Tovelya', widths: '200, 400', sizes: '150px' }}
          {%- else -%}
            <img src="https://cdn.shopify.com/s/files/1/0955/3523/5319/t/1/assets/tovelya-logo-white.png?v=1789520577" alt="Tovelya" width="1844" height="534" loading="lazy">
          {%- endif -%}
        </a>
        <p>Productos útiles, ofertas claras y acompañamiento antes del envío.</p>
      </div>
      <div class="tvh-footer-bottom">
        <small>© {{ 'now' | date: '%Y' }} Tovelya · Colombia</small>
        <nav aria-label="Información de Tovelya"><a href="/policies/shipping-policy">Envíos</a><a href="/policies/refund-policy">Devoluciones</a><a href="/policies/privacy-policy">Privacidad</a><a href="{{ wa }}" target="_blank" rel="noopener">WhatsApp</a></nav>
      </div>
    </div>
    <div class="tvh-echo" aria-hidden="true">tovelya</div>
  </footer>

  <a class="tvh-wa-float" href="{{ wa }}" target="_blank" rel="noopener" aria-label="Escribir a Tovelya por WhatsApp"><svg aria-hidden="true"><use href="#tvh-wa"/></svg></a>
</div>

{% stylesheet %}
  body:has([data-tovelya-brand-home]) .shopify-section-group-header-group,
  body:has([data-tovelya-brand-home]) .shopify-section-group-footer-group{display:none}

  .tvh{
    --navy:#081B35; --navy-2:#0F223B; --ink:#10243F; --soft:#52637A; --line:#D9E3EA;
    --paper:#F5F9F8; --paper-2:#EAF3F1; --accent:#0FA896; --accent-ink:#0A7A6E; --accent-light:#5EF0D8;
    --neon-1:#8BFFF1; --neon-2:#19D3FF; --cta-1:#FFB547; --cta-2:#FF8A1F; --cta-ink:#0F223B;
    --trust-1:#6AA8FF; --trust-2:#2F6FE4; --gold-1:#FFE08A; --gold-2:#FFC23D; --gold-ink:#5A3D00; --ok:#1FB36B; --wa:#1EAE59;
    --fd:"Inter",system-ui,-apple-system,"Segoe UI",sans-serif; --fb:"Manrope","Tovelya Manrope",system-ui,-apple-system,"Segoe UI",sans-serif;
    --ease:cubic-bezier(.22,.8,.35,1); --gut:20px; --sy:64px; --head-gap:32px;
    --h1:38px; --h2:30px; --h3:24px; --lead:16px;
