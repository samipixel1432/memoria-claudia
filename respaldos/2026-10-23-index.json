      "type": "tovelya-cepillo-v2-faq",
      "blocks": {
        "q1": {
          "type": "pregunta",
          "settings": {
            "pregunta": "¿Cómo funciona el pago al recibir?",
            "respuesta": "<p>Haces tu pedido y pagas al transportador cuando lo recibes. Antes de despachar te confirmamos los datos por WhatsApp.</p>"
          }
        },
        "q2": {
          "type": "pregunta",
          "settings": {
            "pregunta": "¿Hacen envíos a toda Colombia?",
            "respuesta": "<p>Enviamos en Colombia, sujeto a la cobertura de la transportadora en tu ciudad. Te informamos el tiempo estimado cuando confirmamos tu pedido.</p>"
          }
        },
        "q3": {
          "type": "pregunta",
          "settings": {
            "pregunta": "¿Qué pasa si mi producto llega con un problema?",
            "respuesta": "<p>Escríbenos por WhatsApp y lo revisamos contigo. Aplicamos nuestra <a href=\"/policies/refund-policy\">política de devoluciones</a>.</p>"
          }
        },
        "q4": {
          "type": "pregunta",
          "settings": {
            "pregunta": "¿Cómo me comunico con Tovelya?",
            "respuesta": "<p>Por <a href=\"https://wa.me/573232552543?text=Hola%20Tovelya%2C%20quiero%20ayuda%20para%20elegir%20un%20producto.\">WhatsApp al +57 323 255 2543</a>. Te respondemos y te acompañamos antes del envío.</p>"
